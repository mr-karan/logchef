    <article class="version" id="v1.4.0">
      <div class="version-header">
        <a class="version-tag" href="#v1.4.0">v1.4.0</a>
        <span class="version-date">Mar 30, 2026</span>
        <a href="https://github.com/mr-karan/logchef/releases/tag/v1.4.0" class="version-link" target="_blank">Release notes &rarr;</a>
      </div>

      <div class="change-section">
        <div class="change-type added">
