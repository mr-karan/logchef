---
import BaseLayout from '../layouts/BaseLayout.astro';

// Swap any v2.8.0 showcase slot from a static light/dark screenshot to a
// video clip by adding an entry here keyed by slot id (e.g. 'hero',
// 'loki-explorer', 'aggregations', 'alerting-v2', 'audit-log',
// 'query-activity', 'scheduled-reports', 'saved-views', 'schema-advisor',
// 'playground'). Put web clips in docs/public/releases/v2.8.0/.
interface ReleaseClip {
  webm?: string;
  mp4: string;
  poster: string;
  width: number;
  height: number;
}

const clip = (key: string): ReleaseClip => ({
  webm: `/releases/v2.8.0/${key}.webm`,
  mp4: `/releases/v2.8.0/${key}.mp4`,
  poster: `/releases/v2.8.0/${key}.png`,
  width: 1280,
  height: 720,
});

const v28Clips: Record<string, ReleaseClip> = {
  hero: clip('hero'),
  'loki-explorer': clip('loki-explorer'),
  aggregations: clip('aggregations'),
  'alerting-v2': clip('alerting-v2'),
  'audit-log': clip('audit-log'),
  'query-activity': clip('query-activity'),
  'scheduled-reports': clip('scheduled-reports'),
  'saved-views': clip('saved-views'),
  'schema-advisor': clip('schema-advisor'),
  playground: clip('playground'),
};

interface ShowcaseShot {
  id: string;
  name: string;
  width: number;
  height: number;
  barLeft: string;
  barRight: string;
  alt: string;
  caption?: string;
  eager?: boolean;
  href?: string;
}

const v28Shots: Record<string, ShowcaseShot> = {
  hero: {
    id: 'hero',
    name: 'v28-mission-control',
    width: 1600,
    height: 1178,
    barLeft: 'Dashboards',
    barRight: 'ClickHouse · VictoriaLogs · Loki',
    alt: 'All Systems Mission Control dashboard in Logchef combining ClickHouse application logs, VictoriaLogs edge metrics and Grafana Loki pod errors on one grid',
    caption: 'All Systems: Mission Control on demo.logchef.app. ClickHouse, VictoriaLogs and Grafana Loki panels sharing one time range.',
    eager: true,
  },
  'loki-explorer': {
    id: 'loki-explorer',
    name: 'v28-loki-explorer',
    width: 1600,
    height: 1000,
    barLeft: 'Log Explorer',
    barRight: 'Grafana Loki · LogchefQL',
    alt: 'Logchef Explorer running app="checkout" and status>=500 on a Grafana Loki Kubernetes Platform source with a 1-hour error spike histogram and preloaded stream labels in the field sidebar',
    caption: 'LogchefQL compiles straight to LogQL. Stream labels preload in the field sidebar while the histogram highlights the incident spike.',
  },
  'loki-dashboard': {
    id: 'loki-dashboard',
    name: 'v28-loki-dashboard',
    width: 1600,
    height: 1267,
    barLeft: 'Dashboards',
    barRight: 'Grafana Loki · Native LogQL',
    alt: 'Kubernetes Platform Loki dashboard displaying stat tiles, volume by level, namespace breakdown, and native LogQL metric charts for errors per app and p95 latency',
    caption: 'LogchefQL panels next to native LogQL metric queries on the same Loki dashboard.',
  },
  aggregations: {
    id: 'aggregations',
    name: 'v28-aggregations',
    width: 1600,
    height: 1000,
    barLeft: 'Log Explorer',
    barRight: 'LogchefQL Aggregations · Chart',
    alt: 'Logchef Explorer plotting p95(duration_ms) by time and service_name across four services with a sharp latency spike at 17:30 and an Add to dashboard button',
    caption: 'One piped LogchefQL query plotted directly in Explorer. Click Add to dashboard to promote it into a panel.',
  },
  'alerting-v2': {
    id: 'alerting-v2',
    name: 'v28-alerting-backtest',
    width: 1600,
    height: 1000,
    barLeft: 'Alerts · Backtest',
    barRight: '5 episodes · 10 notifications',
    alt: 'Alert backtest replaying a grouped rule over 24 hours with a green and red state strip, per-service episode counts, no-data policy, and notify-on-resolve toggle',
    caption: 'Run backtest replays an unsaved rule across up to 120 instants and breaks down episodes per group before you save.',
  },
  'alerting-history': {
    id: 'alerting-history',
    name: 'v28-alerting-history',
    width: 1600,
    height: 867,
    barLeft: 'Alerts · Groups & History',
    barRight: 'Per-service episodes',
    alt: 'Alert history for Error burst by service showing separate resolved episodes for service_name=alerting and service_name=ingestion with View logs buttons',
    caption: 'Each service fires, notifies and resolves on its own timeline, with a direct link to the matching logs.',
  },
  'alerting-silences': {
    id: 'alerting-silences',
    name: 'v28-alerting-silences',
    width: 1600,
    height: 600,
    barLeft: 'Alerts · Silences',
    barRight: 'Maintenance windows & matchers',
    alt: 'Alert silences table showing a weekly Sunday maintenance window for all rules and an active silence matched to service_name=scheduler',
    caption: 'Mute one rule or a whole source once or on a weekly schedule while evaluation and history keep running.',
  },
  'query-activity': {
    id: 'query-activity',
    name: 'v28-query-activity',
    width: 1600,
    height: 1171,
    barLeft: 'Administration · Query Activity',
    barRight: '30 days vs prior window',
    alt: 'Rebuilt Query Activity dashboard showing 23,802 queries, p50 and p95 latency, query language breakdown across LogchefQL, SQL, LogQL and LogsQL, and hot sources with latency sparklines',
    caption: 'Adoption trends, query language mix, and slow sources ranked by total query time, each compared with the prior window.',
  },
  'scheduled-reports': {
    id: 'scheduled-reports',
    name: 'v28-scheduled-reports',
    width: 1600,
    height: 578,
    barLeft: 'Scheduled Reports',
    barRight: 'Dashboards · Tabs · CSV',
    alt: 'Scheduled reports list showing a daily failed payments CSV export in Europe/London, a weekday Mission Control digest in Asia/Kolkata, and a daily Loki payments tab report in UTC',
    caption: 'Each report runs in its own timezone, respects per-recipient source permissions, and attaches CSV rows for saved queries.',
  },
  'saved-views': {
    id: 'saved-views',
    name: 'v28-saved-views',
    width: 1600,
    height: 1000,
    barLeft: 'Log Explorer',
    barRight: 'Saved Views',
    alt: 'Saved Explorer views dropdown open on Kubernetes Platform listing Team and Source views alongside Save as new view and Manage views',
    caption: 'Switch between personal, team and source layouts in one click, or carry your column layout in a share link.',
  },
  'schema-advisor': {
    id: 'schema-advisor',
    name: 'v28-schema-advisor',
    width: 1600,
    height: 844,
    barLeft: 'Source Inspection',
    barRight: 'ClickHouse Schema Advisor',
    alt: 'ClickHouse Source Inspection page for App Logs listing table columns, primary keys, types and the Schema Advisor card with weekly refresh and Run analysis controls',
    caption: 'Joins recorded Explorer filter shapes with ClickHouse metadata and outputs evidence and copyable DDL without running it.',
  },
  playground: {
    id: 'playground',
    name: 'v28-playground',
    width: 1600,
    height: 956,
    barLeft: 'logchef.app/playground',
    barRight: 'WASM compiler · In-browser',
    alt: 'LogchefQL Playground compiling level="error" and status>=500 into ClickHouse SQL, VictoriaLogs LogsQL and Grafana Loki LogQL side by side',
    caption: 'Try live filters and aggregations in the browser. Zero setup, shareable links.',
    href: '/playground/',
  },
};

const v28Nav = [
  { href: '#v2.8.0-loki', label: 'Grafana Loki' },
  { href: '#v2.8.0-aggregations', label: 'Aggregations' },
  { href: '#v2.8.0-alerting', label: 'Alerting v2' },
  { href: '#v2.8.0-audit-log', label: 'Audit log' },
  { href: '#v2.8.0-query-activity', label: 'Query Activity' },
  { href: '#v2.8.0-reports', label: 'Reports' },
  { href: '#v2.8.0-saved-views', label: 'Saved views' },
  { href: '#v2.8.0-schema-advisor', label: 'Schema advisor' },
  { href: '#v2.8.0-mcp-cli', label: 'MCP & CLI' },
  { href: '#v2.8.0-playground', label: 'Playground' },
  { href: '#v2.8.0-upgrading', label: 'Upgrading' },
];

const dockerRunCmd = `docker run --rm -p 8125:8125 -v logchef-data:/data \\
  -e LOGCHEF_AUTH__API_TOKEN_SECRET="$(openssl rand -hex 32)" \\
  -e LOGCHEF_AUTH__LOCAL__ENABLED=true \\
  -e LOGCHEF_AUTH__LOCAL__ADMIN_EMAIL=admin@example.com \\
  -e LOGCHEF_AUTH__LOCAL__ADMIN_PASSWORD=change-me-please \\
  -e LOGCHEF_SERVER__SECURE_COOKIE=false \\
  ghcr.io/mr-karan/logchef:v2.8.0`;

const unreleasedShots = [
  { name: 'palette-scoped', width: 1040, height: 560, alt: 'The Logchef command palette turning @shop/storefront service="payments" and status>=500 last:1h into a Run in Explore row with its team, source and time range', caption: 'Cmd/Ctrl+K, then <code>@team/source</code>: team, source and range completion, with the parsed scope shown before you run it.' },
  { name: 'ask-chef', width: 1160, height: 760, alt: 'Ask Chef answering why payments started failing, next to the error spike in the histogram', caption: 'Ask from the palette: the Explorer opens on the scope and Ask Chef answers with evidence you can run, and says what it could not establish.' },
  { name: 'editor-values', width: 1000, height: 420, alt: 'LogchefQL value suggestions for the service field, each with its count', caption: 'Value suggestions for every field, with counts, as you type.' },
  { name: 'table', width: 1160, height: 422, alt: 'Payment events in the results table with FAILED in red and PENDING in amber', caption: 'Failed and pending outcomes stand out; successful ones stay plain.' },
];
---

<BaseLayout title="Logchef Release Notes and Changelog" description="Logchef release notes and version history: Grafana Loki, VictoriaLogs, dashboards, alerting, the audit log, the CLI, and every change, version by version." activeNav="changelog">
  <style>
    .cl-wrap { position: relative; overflow: clip; }
    .cl-wrap .bg-glow {
      width: min(980px, 125vw); height: min(980px, 125vw);
      top: -42%; left: 50%; transform: translateX(-50%);
    }
    main { position: relative; z-index: 1; max-width: 1060px; margin: 0 auto; padding: 7.5rem 1.5rem 4rem; }

    .page-header { margin-bottom: 2.5rem; padding-bottom: 1.75rem; border-bottom: 1px solid var(--color-border); }
    .page-header .kicker { display: block; margin-bottom: 0.85rem; }
    .page-header h1 { font-size: clamp(2rem, 4.4vw, 2.75rem); font-weight: 700; letter-spacing: -0.033em; margin-bottom: 0.45rem; }
    .page-header p { color: var(--color-text-secondary); font-size: 1.0625rem; }

    .version {
      max-width: 900px;
      margin: 0 auto 3rem;
      padding-bottom: 2.5rem;
      border-bottom: 1px solid var(--color-border);
      scroll-margin-top: 6rem;
    }
    .version:last-child { border-bottom: none; }
    .version.showcase-release {
      max-width: 100%;
      margin-bottom: 4.5rem;
      padding-bottom: 3.5rem;
    }

    /* Older milestone release style kept intact */
    .version.milestone {
      margin-inline: -1.25rem; padding: 1.75rem 1.25rem 2.5rem;
      border: 1px solid color-mix(in srgb, var(--color-accent) 34%, var(--color-border));
      border-radius: 12px;
      background: var(--color-surface);
    }
    .version-header { display: flex; align-items: center; gap: 0.75rem 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
    .version-tag { font-family: var(--font-mono); font-size: 1.1875rem; font-weight: 500; color: var(--color-text); }
    .version-tag.unreleased { color: var(--color-purple); }
    a.version-tag { text-decoration: none; }
    a.version-tag:hover { text-decoration: underline; text-underline-offset: 0.2em; }
    .version-date {
      font-family: var(--font-mono); font-size: 0.8125rem; color: var(--color-text-muted);
      background: var(--color-bg); border: 1px solid var(--color-border);
      padding: 0.25rem 0.625rem; border-radius: 5px;
    }
    .version-badge {
      font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 500;
      text-transform: uppercase; letter-spacing: 0.14em;
      padding: 0.25rem 0.55rem; border-radius: 5px;
      border: 1px solid color-mix(in srgb, var(--color-success) 40%, transparent);
      color: var(--color-success);
    }
    .version-stat {
      font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-text-muted);
    }
    .version-links { display: inline-flex; align-items: center; gap: 1rem; margin-left: auto; flex-wrap: wrap; }
    .version-link { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-text-muted); }
    .version-link:hover { color: var(--color-accent); text-decoration: none; }

    /* ---------------- v2.8.0 Showcase Hero ---------------- */
    .v28-hero {
      position: relative;
      overflow: hidden;
      border: 1px solid color-mix(in srgb, var(--color-accent) 32%, var(--color-border));
      border-radius: 14px;
      background: var(--color-surface);
      padding: clamp(1.5rem, 3.5vw, 2.75rem);
      margin-bottom: 2rem;
    }
    .v28-hero .bg-grid { opacity: 0.85; }
    .v28-hero .bg-glow {
      width: min(760px, 120vw); height: min(760px, 120vw);
      top: -62%; left: 50%; transform: translateX(-50%);
    }
    .v28-hero-inner { position: relative; z-index: 1; }
    .v28-hero-head { max-width: 74ch; margin-bottom: 1.75rem; }
    .v28-eyebrow {
      display: inline-flex; align-items: center; gap: 0.55rem; flex-wrap: wrap;
      border: 1px solid var(--color-border);
      background: var(--color-bg);
      padding: 0.35rem 0.7rem; border-radius: 6px;
      margin-bottom: 1.15rem;
    }
    .v28-eyebrow .kicker { color: var(--color-accent-soft); white-space: nowrap; }
    .v28-eyebrow .sep { width: 1px; height: 11px; background: var(--color-border-strong); flex: none; }
    .v28-eyebrow .what {
      font-family: var(--font-mono); font-size: 0.6875rem;
      letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-secondary);
      white-space: nowrap;
    }
    .v28-title {
      font-size: clamp(1.75rem, 3.8vw, 2.65rem);
      font-weight: 700;
      line-height: 1.08;
      letter-spacing: -0.032em;
      margin-bottom: 0.9rem;
      text-wrap: balance;
    }
    .v28-sub {
      color: var(--color-text-secondary);
      font-size: 1.03125rem;
      line-height: 1.68;
      max-width: 66ch;
    }
    .v28-sub strong { color: var(--color-text); font-weight: 500; }

    /* One query, three engines strip */
    .v28-compiler {
      border: 1px solid var(--color-border);
      border-radius: 10px;
      background: var(--color-bg);
      overflow: hidden;
      margin-bottom: 1.75rem;
    }
    .v28-compiler-in {
      display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; flex-wrap: wrap;
      padding: 0.85rem 1.1rem;
      border-bottom: 1px solid var(--color-border);
      background: var(--color-elevated);
    }
    .v28-compiler-left { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; min-width: 0; }
    .v28-compiler-tag {
      font-family: var(--font-mono); font-size: 0.625rem; font-weight: 500;
      letter-spacing: 0.16em; text-transform: uppercase;
      color: var(--color-accent-soft);
      border: 1px solid color-mix(in srgb, var(--color-accent) 36%, var(--color-border));
      border-radius: 4px; padding: 0.2rem 0.45rem;
      flex: none;
    }
    .v28-compiler-query {
      font-family: var(--font-mono); font-size: 0.9375rem; line-height: 1.4;
      word-break: break-word;
    }
    .v28-compiler-try {
      font-family: var(--font-mono); font-size: 0.72rem;
      color: var(--color-accent-soft); white-space: nowrap;
    }
    .v28-compiler-try:hover { text-decoration: underline; }
    .v28-engines {
      display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1px; background: var(--color-border);
    }
    .v28-engine {
      background: var(--code-bg);
      padding: 0.9rem 1rem;
      min-width: 0;
    }
    .v28-engine-top {
      display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;
      margin-bottom: 0.45rem;
    }
    .v28-engine-name { font-size: 0.8125rem; font-weight: 600; color: var(--color-text); }
    .v28-engine-lang {
      font-family: var(--font-mono); font-size: 0.625rem;
      letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--color-text-muted);
    }
    .v28-engine.is-new .v28-engine-lang { color: var(--color-accent-soft); }
    .v28-engine pre {
      margin: 0;
      font-family: var(--font-mono); font-size: 0.75rem; line-height: 1.6;
      color: var(--color-text-secondary);
      overflow-x: auto;
      white-space: pre-wrap;
      word-break: break-word;
    }

    /* Syntax tokens shared with homepage */
    .q-field { color: var(--q-field); }
    .q-op { color: var(--q-op); }
    .q-str { color: var(--q-str); }
    .q-num { color: var(--q-num); }
    .q-kw { color: var(--q-kw); }

    /* Jump nav rail */
    .v28-jump {
      display: flex; flex-wrap: wrap; gap: 0.45rem;
      margin: 0 0 2.75rem;
      padding: 0.85rem 1rem;
      border: 1px solid var(--color-border);
      border-radius: 10px;
      background: var(--color-surface);
      align-items: center;
    }
    .v28-jump-label {
      font-family: var(--font-mono); font-size: 0.625rem;
      letter-spacing: 0.16em; text-transform: uppercase;
      color: var(--color-text-muted);
      margin-right: 0.35rem;
    }
    .v28-jump a {
      font-family: var(--font-mono); font-size: 0.72rem;
      color: var(--color-text-secondary);
      padding: 0.26rem 0.58rem;
      border: 1px solid var(--color-border);
      border-radius: 5px;
      background: var(--color-bg);
      text-decoration: none;
      transition: color 0.15s ease, border-color 0.15s ease;
    }
    .v28-jump a:hover {
      color: var(--color-text);
      border-color: color-mix(in srgb, var(--color-accent) 48%, var(--color-border));
      text-decoration: none;
    }

    /* ---------------- Product Frame (matches index.astro) ---------------- */
    .frame {
      position: relative;
      border: 1px solid var(--color-border);
      border-radius: 12px;
      background: var(--color-surface);
      box-shadow: var(--shadow-frame);
      overflow: hidden;
    }
    .frame-link { display: block; color: inherit; text-decoration: none; }
    .frame-link:hover { text-decoration: none; }
    .frame-link:hover .frame { border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border)); }
    .frame-bar {
      display: flex; align-items: center; gap: 0.6rem;
      min-height: 34px; padding: 0.35rem 0.9rem;
      border-bottom: 1px solid var(--color-border);
      background: var(--color-elevated);
      font-family: var(--font-mono); font-size: 0.625rem;
      letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--color-text-muted);
    }
    .frame-bar .right { margin-left: auto; color: var(--color-text-muted); text-align: right; }
    .frame-media { position: relative; background: var(--color-bg); }
    .frame-media picture { display: block; }
    .frame-media img,
    .frame-media video {
      display: block;
      width: 100%;
      height: auto;
    }
    .frame-media .shot-dark { display: none; }
    :root[data-theme='dark'] .frame-media .shot-light { display: none; }
    :root[data-theme='dark'] .frame-media .shot-dark { display: block; }

    .v28-figure { margin: 0; }
    .v28-figure figcaption {
      margin-top: 0.65rem;
      color: var(--color-text-muted);
      font-size: 0.85rem;
      line-height: 1.55;
    }
    .v28-figure figcaption code {
      font-family: var(--font-mono); font-size: 0.78rem;
      background: var(--color-surface); border: 1px solid var(--color-border);
      padding: 0.1em 0.35em; border-radius: 4px; color: var(--color-accent-soft);
    }

    /* ---------------- Feature Showcase Sections ---------------- */
    .v28-sections {
      display: flex;
      flex-direction: column;
      gap: 3.5rem;
      margin-bottom: 3.5rem;
    }
    .v28-feature {
      padding-top: 2.5rem;
      border-top: 1px solid var(--color-border);
      scroll-margin-top: 5.5rem;
    }
    .v28-feature:first-child { padding-top: 0; border-top: none; }

    .v28-feature-head {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: 1.5rem 2.25rem;
      align-items: start;
      margin-bottom: 1.5rem;
    }
    .v28-feature-head.is-single {
      grid-template-columns: minmax(0, 1fr);
      max-width: 72ch;
    }
    .v28-feature-copy .kicker { display: block; color: var(--color-accent-soft); margin-bottom: 0.55rem; }
    .v28-feature-copy h3 {
      font-size: clamp(1.3rem, 2.4vw, 1.65rem);
      font-weight: 700;
      letter-spacing: -0.025em;
      line-height: 1.18;
      margin-bottom: 0.65rem;
    }
    .v28-feature-copy p {
      color: var(--color-text-secondary);
      font-size: 0.96875rem;
      line-height: 1.68;
      margin-bottom: 0.7rem;
    }
    .v28-feature-copy p:last-child { margin-bottom: 0; }
    .v28-feature-copy strong { color: var(--color-text); font-weight: 500; }
    .v28-feature-copy code {
      font-family: var(--font-mono); font-size: 0.82rem;
      background: var(--color-surface); border: 1px solid var(--color-border);
      padding: 0.1em 0.35em; border-radius: 4px; color: var(--color-accent-soft);
    }
    .v28-links {
      display: flex; flex-wrap: wrap; gap: 0.9rem;
      margin-top: 0.85rem;
      font-family: var(--font-mono); font-size: 0.78rem;
    }
    .v28-links a { color: var(--color-accent-soft); }

    /* Code card beside feature copy */
    .v28-code {
      border: 1px solid var(--color-border);
      border-radius: 10px;
      background: var(--code-bg);
      overflow: hidden;
      min-width: 0;
    }
    .v28-code-bar {
      display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;
      padding: 0.48rem 0.85rem;
      border-bottom: 1px solid var(--color-border);
      background: var(--color-elevated);
      font-family: var(--font-mono); font-size: 0.625rem;
      letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--color-text-muted);
    }
    .v28-code pre {
      margin: 0;
      padding: 0.95rem 1.05rem;
      font-family: var(--font-mono); font-size: 0.78rem; line-height: 1.68;
      color: var(--color-text);
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }
    .v28-code-divider {
      border-top: 1px solid var(--color-border);
      padding: 0.45rem 0.85rem;
      background: var(--color-elevated);
      font-family: var(--font-mono); font-size: 0.625rem;
      letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--color-text-muted);
    }

    /* Two-up media grid for secondary proof shots */
