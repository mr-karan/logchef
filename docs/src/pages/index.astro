---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroLogAnimation from '../components/home/HeroLogAnimation.astro';
---

<BaseLayout
  title="Logchef 2.0: Open-Source Log Analytics for ClickHouse and VictoriaLogs"
  description="Search, live tail, dashboards, and alerts for logs stored in ClickHouse or VictoriaLogs. One open-source, self-hosted binary with no new log storage layer."
  activeNav="home"
>
  <style>
    /* ------------------------------------------------------------------ *
     * Homepage visual language carried over from the Logchef 2.0 film.
     * Blue is the only brand colour. Thin borders, fine grid, restrained
     * glow. Mono is structural chrome, not body copy.
     * ------------------------------------------------------------------ */

    .wrap { max-width: 1180px; margin: 0 auto; padding-inline: 1.5rem; }

    /* ---------------- Hero ---------------- */
    .hero {
      position: relative;
      padding: 9rem 0 0;
      overflow: hidden;
      border-bottom: 1px solid var(--color-border);
    }
    .hero .bg-glow {
      width: min(1100px, 130vw); height: min(1100px, 130vw);
      top: -55%; left: 50%; transform: translateX(-50%);
    }

    /* Pointer torchlight across the whole hero: a brighter, accent-tinted
       copy of the grid revealed through a small radial mask that follows
       the pointer. The parent .bg-grid's own mask still applies, so the
       reveal fades out toward the bottom of the hero like the base grid. */
    .hero .bg-grid::after {
      content: "";
      position: absolute; inset: 0;
      background-image:
        linear-gradient(color-mix(in srgb, var(--color-accent) 24%, transparent) 1px, transparent 1px),
        linear-gradient(90deg, color-mix(in srgb, var(--color-accent) 24%, transparent) 1px, transparent 1px);
      background-size: 72px 72px;
      opacity: 0;
      transition: opacity 0.35s ease;
      mask-image: radial-gradient(circle 250px at var(--torch-x, 50%) var(--torch-y, 40%), #000 0%, transparent 72%);
      -webkit-mask-image: radial-gradient(circle 250px at var(--torch-x, 50%) var(--torch-y, 40%), #000 0%, transparent 72%);
    }
    .hero.torch-on .bg-grid::after { opacity: 1; }
    .hero-inner { position: relative; z-index: 1; }

    /* Two columns at desktop: copy left, the log observatory right. The
       scene is decorative canvas, so the copy column keeps priority and
       the visual collapses under it on smaller screens. */
    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      gap: clamp(1.5rem, 3vw, 3rem);
      align-items: center;
      margin-bottom: 3.25rem;
    }
    .hero-copy { min-width: 0; }
    .hero-visual {
      position: relative;
      min-height: 460px;
      /* Bleed slightly past the container edge; the canvas mask fades the
         scene into the hero grid, so there is no hard box to respect. */
      margin-right: clamp(-2.5rem, -2vw, -1rem);
    }

    .eyebrow {
      display: inline-flex; align-items: center; gap: 0.6rem;
      border: 1px solid var(--color-border);
      background: var(--color-surface);
      padding: 0.4rem 0.8rem; border-radius: 6px;
      margin-bottom: 2rem;
    }
    .eyebrow .kicker { color: var(--color-accent-soft); }
    .eyebrow .sep { width: 1px; height: 11px; background: var(--color-border-strong); }
    .eyebrow .what { font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-secondary); }

    .hero-title {
      font-size: clamp(2.1rem, 4.7vw, 3.5rem);
      font-weight: 700;
      line-height: 1.06;
      letter-spacing: -0.033em;
      margin-bottom: 1.5rem;
    }
    /* In the two-column hero the title shares the row with the scene, so it
       steps down just enough to keep each deliberate line unwrapped. */
    @media (min-width: 1024px) {
      .hero-title { font-size: clamp(2rem, 2.6vw, 2.8rem); }
    }
    /* Two deliberate lines rather than a <br> keep the datasource pair on
       its own line at every width without losing the inter-word space. */
    .hero-title > span { display: block; }

    .hero-desc {
      font-size: 1.0625rem;
      color: var(--color-text-secondary);
      max-width: 60ch;
      line-height: 1.7;
      margin-bottom: 2.25rem;
    }
    .hero-desc strong { color: var(--color-text); font-weight: 500; }

    .hero-actions {
      display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem;
    }
    .gh-stars { display: inline-flex; align-items: center; margin-left: 0.25rem; }
    .gh-stars img { height: 20px; }

    /* Product proof bar. Each claim gets a category and a concrete value so
       this reads as product architecture rather than a row of keywords. */
    .proof-rail {
      display: grid;
      grid-template-columns: 0.9fr 1.1fr 1.3fr 1fr 0.9fr;
      border: 1px solid var(--color-border);
      border-radius: 10px;
      background: color-mix(in srgb, var(--color-surface) 76%, transparent);
      overflow: hidden;
      box-shadow: 0 14px 40px color-mix(in srgb, var(--color-bg) 70%, transparent);
    }
    .proof-item {
      min-width: 0;
      display: flex;
      align-items: center;
      gap: 0.7rem;
      padding: 0.9rem 1rem;
    }
    .proof-item + .proof-item { border-left: 1px solid var(--color-border); }
    .proof-icon {
      width: 30px; height: 30px;
      flex: none;
      display: grid; place-items: center;
      border: 1px solid color-mix(in srgb, var(--color-accent) 30%, var(--color-border));
      border-radius: 7px;
      color: var(--color-accent);
      background: color-mix(in srgb, var(--color-accent) 8%, transparent);
    }
    .proof-icon svg { width: 15px; height: 15px; }
    .proof-copy { min-width: 0; display: flex; flex-direction: column; gap: 0.2rem; }
    .proof-label {
      font-family: var(--font-mono);
      font-size: 0.5625rem;
      line-height: 1.2;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--color-text-muted);
      white-space: nowrap;
    }
    .proof-value {
      font-size: 0.7813rem;
      line-height: 1.35;
      font-weight: 600;
      color: var(--color-text);
      text-wrap: balance;
    }

    /* Hero product shot */
    .hero-shot {
      position: relative; z-index: 1;
      max-width: 1400px; margin: 3.5rem auto 0;
      padding-inline: 1.5rem;
    }
    .frame {
      position: relative;
      border: 1px solid var(--color-border);
      border-top-left-radius: 12px; border-top-right-radius: 12px;
      background: var(--color-surface);
      box-shadow: var(--shadow-frame);
      overflow: hidden;
    }
    .frame-bar {
      display: flex; align-items: center; gap: 0.6rem;
      height: 34px; padding: 0 0.9rem;
      border-bottom: 1px solid var(--color-border);
      background: var(--color-elevated);
      font-family: var(--font-mono); font-size: 0.625rem;
      letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--color-text-muted);
    }
    .frame-bar .right { margin-left: auto; color: var(--color-text-muted); }
    .frame-shot { position: relative; overflow: hidden; aspect-ratio: 1800 / 1124; }
    /* The hero shot bleeds off the bottom of the viewport, film-style. */
    .hero-shot .frame-shot {
      aspect-ratio: 1800 / 900;
      mask-image: linear-gradient(180deg, #000 72%, transparent 100%);
      -webkit-mask-image: linear-gradient(180deg, #000 72%, transparent 100%);
    }

    .theme-img {
      position: absolute; inset: 0;
      width: 100%; height: 100%;
      object-fit: cover; object-position: top center;
      opacity: 0;
      transition: opacity 0.25s ease;
    }
    /* The ai-* assets have a black bezel baked in; scale past it. */
    .theme-img[src^="/screenshots/ai-"] { transform: scale(1.075); }
    .theme-img-light { opacity: 1; }
    :root[data-theme='dark'] .theme-img-light { opacity: 0; }
    :root[data-theme='dark'] .theme-img-dark { opacity: 1; }

    /* ---------------- Section scaffolding ---------------- */
    .section { padding: 6rem 0; border-bottom: 1px solid var(--color-border); }
    .section-head { margin-bottom: 3.5rem; max-width: 66ch; }
    .section-head .kicker { display: block; margin-bottom: 0.9rem; }
    .section-title {
      font-size: clamp(1.6rem, 3vw, 2.15rem);
      font-weight: 700; letter-spacing: -0.025em; line-height: 1.15;
      text-wrap: balance;
    }
    .section-desc {
      margin-top: 0.9rem; color: var(--color-text-secondary);
      font-size: 1rem; line-height: 1.7;
    }

    /* ---------------- One query, two backends ---------------- */
    .translate { position: relative; overflow: hidden; }
    .translate .bg-glow {
      width: min(900px, 120vw); height: min(900px, 120vw);
      top: -30%; left: 50%; transform: translateX(-50%);
      opacity: 0.7;
    }
    .translate-inner { position: relative; z-index: 1; }

    .qhead { text-align: center; margin-bottom: 3.25rem; }
    .qhead .kicker { display: block; color: var(--color-accent-soft); margin-bottom: 1rem; }
    .qhead .section-title { margin-bottom: 1.25rem; }
    .qsource {
      font-family: var(--font-mono);
      font-size: clamp(1rem, 2.6vw, 1.75rem);
      letter-spacing: -0.01em;
      line-height: 1.5;
      word-break: break-word;
      margin-bottom: 1rem;
    }
    .qhead p { color: var(--color-text-secondary); font-size: 1rem; }

    /* Query token colours, matched to the film's editor */
    .q-field { color: var(--q-field); }
    .q-op { color: var(--q-op); }
    .q-str { color: var(--q-str); }
    .q-num { color: var(--q-num); }
    .q-kw { color: var(--q-kw); }

    .panels { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
    .panel {
      border: 1px solid var(--color-border);
      border-radius: 12px;
      background: var(--color-surface);
      padding: 1.75rem;
      display: flex; flex-direction: column; gap: 1.25rem;
    }
    .panel-name {
      font-family: var(--font-mono); font-size: 0.75rem;
      letter-spacing: 0.24em; text-transform: uppercase; font-weight: 500;
      color: var(--color-text);
    }
    .panel h3 { font-size: 1.25rem; font-weight: 600; letter-spacing: -0.015em; margin-top: -0.5rem; }
    .panel-chip {
      align-self: flex-start;
      font-family: var(--font-mono); font-size: 0.75rem;
      color: var(--color-text-secondary);
      border: 1px solid var(--color-border-strong);
      border-radius: 6px; padding: 0.3rem 0.6rem;
      margin-top: -0.5rem;
    }
    .panel-label {
      font-family: var(--font-mono); font-size: 0.625rem;
      letter-spacing: 0.16em; text-transform: uppercase;
      color: var(--color-text-muted);
      margin-bottom: 0.55rem;
    }
    .panel-code {
      background: var(--code-bg);
      border: 1px solid var(--color-border);
      border-radius: 8px;
      padding: 1rem 1.1rem;
      font-family: var(--font-mono); font-size: 0.8125rem; line-height: 1.75;
      overflow-x: auto;
    }
    .panel-code pre { margin: 0; }
    .panel-event {
      border: 1px solid var(--color-border);
      border-left: 2px solid var(--color-accent);
      border-radius: 6px;
      background: var(--code-bg);
      padding: 0.65rem 0.85rem;
      font-family: var(--font-mono); font-size: 0.75rem;
      color: var(--color-text-secondary);
      overflow-x: auto; white-space: nowrap;
      /* The row is longer than the panel by design. Fade the tail so the
         overflow reads as "there is more", not as a broken clip. */
      mask-image: linear-gradient(90deg, #000 88%, transparent 100%);
      -webkit-mask-image: linear-gradient(90deg, #000 88%, transparent 100%);
      scrollbar-width: none;
    }
    .panel-event::-webkit-scrollbar { display: none; }
    .panel-event .ts { color: var(--color-text-muted); }
    .panel-event .lvl { color: var(--color-error); font-weight: 500; }
    .panel-event .msg { color: var(--color-text); }
    .panel-grow { margin-top: auto; }

    /* Product-truth footnote under the two panels */
    .truth {
      margin-top: 2rem;
      display: flex; align-items: flex-start; gap: 0.85rem;
      border: 1px solid var(--color-border);
      border-radius: 10px;
      background: var(--color-surface);
      padding: 1.1rem 1.3rem;
    }
    .truth .logbars { margin-top: 0.35rem; }
    .truth p { color: var(--color-text-secondary); font-size: 0.9375rem; line-height: 1.65; }
    .truth strong { color: var(--color-text); font-weight: 600; }

    /* ---------------- Showcase ---------------- */
    .showcase-list {
      display: flex; flex-direction: column;
      gap: clamp(3rem, 6vw, 4.5rem);
    }
    .showcase-item {
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
      gap: clamp(1.75rem, 4vw, 3.25rem);
      align-items: center;
    }
    /* Alternate sides by swapping the track sizes, not by reordering. The
       media must stay in the wide track whichever side it sits on. */
    .showcase-item .showcase-media { grid-area: 1 / 1; }
    .showcase-item .showcase-text { grid-area: 1 / 2; }
    .showcase-item.is-reversed { grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); }
    .showcase-item.is-reversed .showcase-media { grid-area: 1 / 2; }
    .showcase-item.is-reversed .showcase-text { grid-area: 1 / 1; }
    .showcase-text { max-width: 44ch; }
    .showcase-text .kicker { display: block; margin-bottom: 0.75rem; }
    .showcase-text h3 {
      font-size: 1.3rem; font-weight: 600;
      letter-spacing: -0.02em; margin-bottom: 0.6rem;
    }
    .showcase-text p { color: var(--color-text-secondary); font-size: 0.9688rem; line-height: 1.7; }
    .showcase-media .frame { border-radius: 12px; }
    /* Uniform frames keep the rhythm. The screenshots have wildly different
       native aspect ratios, so crop from the top where the signal is. */
    .showcase-media .frame-shot { aspect-ratio: 16 / 10; }

    /* ---------------- v2 product proof ---------------- */
    .v2-proof { background: color-mix(in srgb, var(--color-surface) 34%, var(--color-bg)); }
    .v2-proof .frame-shot { aspect-ratio: 1280 / 577; }
    .proof-img {
      position: absolute; inset: 0;
      width: 100%; height: 100%; object-fit: cover; object-position: top center;
    }

    /* ---------------- Feature grid ---------------- */
    .features-grid {
      display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1px;
      background: var(--color-border);
      border: 1px solid var(--color-border);
      border-radius: 12px;
      overflow: hidden;
    }
    .feature {
      background: var(--color-bg);
      padding: 1.85rem 1.65rem;
      display: flex; flex-direction: column; gap: 0.7rem;
    }
    .feature-top { display: flex; align-items: center; gap: 0.7rem; }
    .feature-top svg { width: 18px; height: 18px; color: var(--color-accent); flex: none; }
    .feature h3 { font-size: 1rem; font-weight: 600; letter-spacing: -0.01em; }
    .feature p { color: var(--color-text-secondary); font-size: 0.9063rem; line-height: 1.65; }

    /* ---------------- Agent-native workflows ---------------- */
    .agent-native {
      background: color-mix(in srgb, var(--color-surface) 34%, var(--color-bg));
    }
    /* A real CLI investigation, rendered from a live session. The terminal
       stays dark in both themes; the frame chrome adapts. */
    .agent-cli { margin-bottom: 2.5rem; }
    .agent-cli .frame-shot {
      aspect-ratio: 2482 / 771;
      background: #0d0d10;
    }
    .agent-cli img { display: block; width: 100%; height: 100%; }
    /* Small screens: keep the session readable by letting it scroll sideways
       inside its own frame instead of shrinking into an illegible strip. */
    @media (max-width: 700px) {
      .agent-cli .frame-bar .right { display: none; }
      .agent-cli .frame-shot {
        aspect-ratio: auto;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }
      .agent-cli img { width: 720px; height: auto; }
    }
    .agent-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .agent-feature {
      color: inherit;
      text-decoration: none;
      transition: background-color 0.15s ease;
    }
    .agent-feature:hover { background: var(--color-surface); text-decoration: none; }
    .agent-proof {
      align-self: flex-start;
      margin-top: auto;
      border: 1px solid var(--color-border-strong);
      border-radius: 6px;
      padding: 0.35rem 0.55rem;
      color: var(--color-text-secondary);
      background: var(--code-bg);
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      line-height: 1.4;
    }

    /* ---------------- Quickstart terminal ---------------- */
    .quickstart-inner { max-width: 860px; margin: 0 auto; }
    .quickstart-inner .section-head { margin-inline: auto; text-align: center; }
    .term {
      border: 1px solid var(--color-border);
      border-radius: 12px;
      background: var(--code-bg);
      overflow: hidden;
      box-shadow: var(--shadow-frame);
    }
    .term-head {
      display: flex; align-items: center; gap: 0.25rem;
      height: 42px; padding: 0 0.75rem;
      border-bottom: 1px solid var(--color-border);
      background: var(--color-elevated);
    }
    .code-tab {
      font-family: var(--font-mono); font-size: 0.75rem;
      color: var(--color-text-muted);
      background: none; border: none; padding: 0.4rem 0.8rem;
      cursor: pointer; border-radius: 6px;
      transition: color 0.15s ease, background-color 0.15s ease;
    }
    .code-tab.active { color: var(--color-text); background: var(--color-bg); }
    .code-tab:hover:not(.active) { color: var(--color-text-secondary); }
    .copy-btn {
      margin-left: auto;
      font-family: var(--font-mono); font-size: 0.6875rem;
      color: var(--color-text-secondary);
      background: var(--color-bg); border: 1px solid var(--color-border);
      padding: 0.35rem 0.6rem; border-radius: 6px; cursor: pointer;
      transition: color 0.15s ease, border-color 0.15s ease;
    }
    .copy-btn:hover { color: var(--color-text); border-color: var(--color-text-dim); }
    .term-body {
      padding: 1.35rem 1.5rem;
      font-family: var(--font-mono); font-size: 0.8125rem; line-height: 1.85;
      overflow-x: auto;
    }
    .term-body pre { margin: 0; }
    .code-comment { color: var(--color-text-secondary); }
    .code-string { color: var(--color-success); }

    /* ---------------- Existing-stack architecture ---------------- */
    .stack-map {
      position: relative;
      overflow: hidden;
      background: color-mix(in srgb, var(--color-surface) 34%, var(--color-bg));
    }
    .stack-map::before {
      content: "";
      position: absolute; inset: 0;
      pointer-events: none;
      opacity: 0.35;
      background-image:
        linear-gradient(var(--color-grid) 1px, transparent 1px),
        linear-gradient(90deg, var(--color-grid) 1px, transparent 1px);
      background-size: 72px 72px;
      mask-image: linear-gradient(90deg, transparent, #000 22%, #000 78%, transparent);
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 22%, #000 78%, transparent);
    }
    .stack-map-inner { position: relative; z-index: 1; }
    .stack-map .section-head { margin-inline: auto; text-align: center; }
    .stack-flow {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 112px minmax(0, 1.08fr) 112px minmax(0, 1fr);
      align-items: stretch;
    }
    .stack-node {
      min-width: 0;
      min-height: 218px;
      display: flex;
      flex-direction: column;
      border: 1px solid var(--color-border);
      border-radius: 12px;
      background: color-mix(in srgb, var(--color-surface) 92%, transparent);
      padding: 1.5rem;
      box-shadow: 0 18px 50px color-mix(in srgb, var(--color-bg) 52%, transparent);
    }
    .stack-node.is-logchef {
      border-color: color-mix(in srgb, var(--color-accent) 42%, var(--color-border));
      background:
        radial-gradient(circle at 50% 0%, color-mix(in srgb, var(--color-accent) 13%, transparent), transparent 58%),
        var(--color-surface);
    }
    .stack-node-label {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      margin-bottom: 1.15rem;
      font-family: var(--font-mono);
      font-size: 0.5938rem;
      line-height: 1.2;
      letter-spacing: 0.17em;
      text-transform: uppercase;
      color: var(--color-text-muted);
    }
    .stack-node-label .logbars { transform: scale(0.9); transform-origin: left center; }
    .stack-node h3 {
      margin-bottom: 0.55rem;
      font-size: 1.125rem;
      font-weight: 600;
      letter-spacing: -0.015em;
    }
    .stack-node p {
      color: var(--color-text-secondary);
      font-size: 0.875rem;
      line-height: 1.6;
    }
    .stack-products {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: auto;
      padding-top: 1.25rem;
    }
    .stack-product {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      min-height: 34px;
      border: 1px solid var(--color-border-strong);
      border-radius: 7px;
      padding: 0.4rem 0.6rem;
      background: var(--color-bg);
      color: var(--color-text-secondary);
      font-size: 0.75rem;
      font-weight: 500;
      transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
    }
    .stack-product:hover {
      color: var(--color-text);
      border-color: color-mix(in srgb, var(--color-accent) 42%, var(--color-border));
      background: var(--color-elevated);
      text-decoration: none;
    }
    .stack-product svg { width: 15px; height: 15px; flex: none; }
    .stack-product.is-static { pointer-events: none; }
    .flow-connector {
      min-width: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 0.55rem;
      color: var(--color-text-muted);
    }
    .flow-connector span {
      font-family: var(--font-mono);
      font-size: 0.5625rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      white-space: nowrap;
    }
    .flow-connector svg { width: 80px; height: 18px; overflow: visible; }
    .flow-connector path { vector-effect: non-scaling-stroke; }
    .flow-connector.is-query { color: var(--color-accent); }
    .stack-truth {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.65rem;
      margin: 1.5rem auto 0;
      color: var(--color-text-secondary);
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      letter-spacing: 0.04em;
      text-align: center;
    }
    .stack-truth svg { width: 15px; height: 15px; color: var(--color-accent); flex: none; }

    /* ---------------- Closing CTA ---------------- */
    .closing { padding: 1rem 0 7rem; }
    .closing-card {
