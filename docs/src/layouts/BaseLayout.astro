---
import Seo from '../components/Seo.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  activeNav?: 'home' | 'docs' | 'blog' | 'changelog' | 'demo';
  structuredData?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = "Open-source log explorer for ClickHouse and VictoriaLogs",
  image,
  activeNav,
  structuredData = true,
  noindex = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex, nofollow">}

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="alternate icon" href="/favicon.ico">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <!-- RSS autodiscovery (feed generated by src/pages/rss.xml.js -> /rss.xml) -->
  <link rel="alternate" type="application/rss+xml" title="Logchef Blog" href="/rss.xml">

  <!--
    Markdown autodiscovery for LLMs and agents (generated by starlight-llms-txt).
    Agents conventionally probe /llms.txt directly, but advertising it here means
    anything that parses <head> finds the Markdown corpus without guessing.
  -->
  <link rel="alternate" type="text/markdown" title="Logchef docs for LLMs" href="/llms.txt">

  <!--
    Search engine ownership verification (site-wide via the homepage at "/").
    MAINTAINER: paste your token into `content` and uncomment the relevant line.
    - Google Search Console: Settings -> Ownership verification -> HTML tag.
    - Bing Webmaster Tools: Add site -> HTML Meta Tag.
    Leave commented/empty until filled — these are no-ops as-is.
  -->
  <!-- <meta name="google-site-verification" content=""> -->
  <!-- <meta name="msvalidate.01" content=""> -->

  <Seo title={title} description={description} image={image} structuredData={structuredData} />

  <!-- Self-hosted fonts (subsetted latin, matches weights actually used: Inter 400/500/600/700 via variable font, DM Mono 400/500). -->
  <link rel="preload" href="/fonts/inter-var-latin.woff2" as="font" type="font/woff2" crossorigin>

  <!-- Umami Analytics -->
  <script defer src="https://um.mrkaran.dev/script.js" data-website-id="7c608903-19f6-4782-8def-c03e71ff35fc"></script>

  <!-- Theme initialization (before render to prevent flash) -->
  <script is:inline>
    (function() {
      const theme = localStorage.getItem('logchef-theme') || 'dark';
      document.documentElement.setAttribute('data-theme', theme);
      // Scroll-reveal styles hide content until an observer fires. Gate them on
      // this class so the page stays fully readable when JS never runs.
      document.documentElement.classList.add('js');
    })();
  </script>

  <style is:global>
    @font-face {
      font-family: 'Inter';
      font-style: normal;
      font-weight: 100 900;
      font-display: swap;
      src: url('/fonts/inter-var-latin.woff2') format('woff2');
    }
    @font-face {
      font-family: 'DM Mono';
      font-style: normal;
      font-weight: 400;
      font-display: swap;
      src: url('/fonts/dm-mono-400-latin.woff2') format('woff2');
    }
    @font-face {
      font-family: 'DM Mono';
      font-style: normal;
      font-weight: 500;
      font-display: swap;
      src: url('/fonts/dm-mono-500-latin.woff2') format('woff2');
    }

    :root {
      --font-sans: 'Inter', system-ui, sans-serif;
      --font-mono: 'DM Mono', 'SF Mono', monospace;
    }

    /*
      Palette carried over from the Logchef 2.0 launch film (css/film.css).
      Blue is the only brand colour; everything else is neutral. Green, amber
      and red are reserved for state (success, warning, error), never for
      labelling a datasource.
      The film is dark-only; the light theme below is a deliberate counterpart
      that keeps the same structure while meeting text contrast on white.
    */

    /* Dark theme (default) */
    :root, [data-theme="dark"] {
      --color-bg: #0a0a0b;
      --color-surface: #111113;
      --color-elevated: #141417;
      --color-border: #1f1f23;
      --color-border-strong: #2a2a30;
      --color-text: #e4e4e7;
      --color-text-secondary: #a1a1aa;
      /* Readable muted tone for small mono labels — the film's #52525b is
         decorative-only chrome and fails body contrast on #0a0a0b. Chosen to
         clear 4.5:1 on bg, surface AND elevated, since labels sit on all three. */
      --color-text-muted: #82828c;
      --color-text-dim: #52525b;
      --color-accent: #3b82f6;
      --color-accent-hover: #1d4ed8;
      --color-accent-soft: #60a5fa;
      /* Filled surfaces use the official mark's blue (LOGCHEF.svg): white on
         #3b82f6 is only 3.68:1, which fails AA for button-sized text. */
      --color-accent-solid: #2563eb;
      --color-success: #22c55e;
      --color-warning: #f59e0b;
      --color-error: #ef4444;
      --color-purple: #a855f7;

      /* Ambient layers */
      --grid-line: rgba(228, 228, 231, 0.030);
      --glow-blue: rgba(59, 130, 246, 0.11);
      --glow-blue-mid: rgba(59, 130, 246, 0.035);
      --shadow-frame: 0 30px 90px rgba(0, 0, 0, 0.55);
      --code-bg: #0d0d10;

      /* Query syntax */
      --q-field: #e8a3a3;
      --q-op: #a1a1aa;
      --q-str: #7fb5f0;
      --q-num: #d0a56b;
      --q-kw: #60a5fa;
      --q-comment: #6b6b75;
    }

    /* Light theme */
    [data-theme="light"] {
      --color-bg: #ffffff;
      --color-surface: #fafafa;
      --color-elevated: #f4f4f5;
      --color-border: #e6e6ea;
      --color-border-strong: #d4d4d8;
      --color-text: #18181b;
      --color-text-secondary: #52525b;
      --color-text-muted: #6b6b76;
      --color-text-dim: #8f8f9a;
      --color-accent: #2563eb;
      --color-accent-hover: #1d4ed8;
      --color-accent-soft: #1d4ed8;
      --color-accent-solid: #2563eb;
      --color-success: #16a34a;
      --color-warning: #d97706;
      --color-error: #dc2626;
      --color-purple: #9333ea;

      --grid-line: rgba(24, 24, 27, 0.045);
      --glow-blue: rgba(37, 99, 235, 0.10);
      --glow-blue-mid: rgba(37, 99, 235, 0.035);
      --shadow-frame: 0 24px 70px -30px rgba(24, 24, 27, 0.28);
      --code-bg: #f7f7f9;

      --q-field: #9f3d3d;
      --q-op: #52525b;
      --q-str: #1d4ed8;
      --q-num: #a16207;
      --q-kw: #1d4ed8;
      --q-comment: #71717a;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; font-size: 16px; }
    body {
      font-family: var(--font-sans);
      background: var(--color-bg);
      color: var(--color-text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      transition: background-color 0.2s ease, color 0.2s ease;
    }
    ::selection { background: var(--color-accent-solid); color: white; }
    a { color: var(--color-accent); text-decoration: none; }
    a:hover { text-decoration: underline; }

    /* Keyboard focus — visible on every interactive surface */
    :focus-visible {
      outline: 2px solid var(--color-accent-soft);
      outline-offset: 3px;
      border-radius: 4px;
    }

    /* ---- Shared brand primitives (carried from the launch film) ---- */

    /* Wide-tracked mono label. The film's structural kicker. */
    .kicker {
      font-family: var(--font-mono);
      font-weight: 500;
      font-size: 0.6875rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--color-text-muted);
    }

    /* The Logchef mark's four staggered log lines, used as a rhythm device. */
    .logbars {
      display: inline-flex;
      flex-direction: column;
      gap: 2px;
      flex: none;
    }
    .logbars i {
      display: block; height: 2px; border-radius: 1px;
      background: var(--color-accent);
    }
    .logbars i:nth-child(1) { width: 14px; }
    .logbars i:nth-child(2) { width: 9px; }
    .logbars i:nth-child(3) { width: 11px; opacity: 0.75; }
    .logbars i:nth-child(4) { width: 5px; opacity: 0.5; }

    /* Fine grid + soft radial glow. No glassmorphism, no bloom. */
    .bg-grid {
      position: absolute; inset: 0; pointer-events: none; z-index: 0;
      background-image:
        linear-gradient(var(--grid-line) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
      background-size: 72px 72px;
      mask-image: radial-gradient(ellipse 100% 70% at 50% 0%, #000 30%, transparent 78%);
      -webkit-mask-image: radial-gradient(ellipse 100% 70% at 50% 0%, #000 30%, transparent 78%);
    }
    .bg-glow {
      position: absolute; pointer-events: none; z-index: 0;
      border-radius: 50%;
      background: radial-gradient(circle, var(--glow-blue) 0%, var(--glow-blue-mid) 42%, transparent 70%);
    }

    /* Buttons */
    .btn {
      display: inline-flex; align-items: center; gap: 0.5rem;
      font-family: var(--font-sans); font-size: 0.9rem; font-weight: 500;
      padding: 0.7rem 1.35rem; border-radius: 8px;
      border: 1px solid transparent; cursor: pointer; text-decoration: none;
      transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    }
    .btn:hover { text-decoration: none; }
    .btn-primary { background: var(--color-accent-solid); color: #fff; }
    .btn-primary:hover { background: var(--color-accent-hover); }
    .btn-secondary {
      background: transparent; color: var(--color-text);
      border-color: var(--color-border-strong);
    }
    .btn-secondary:hover { background: var(--color-surface); border-color: var(--color-text-dim); }
    .btn svg { width: 17px; height: 17px; flex: none; }

    /* Nav */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      padding: 0.75rem 1.5rem;
      background: color-mix(in srgb, var(--color-bg) 85%, transparent);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--color-border);
    }
    .nav-inner {
      max-width: 1180px; margin: 0 auto;
      display: flex; justify-content: space-between; align-items: center;
    }
    .nav-logo {
      display: flex; align-items: center; gap: 0.5rem;
      font-weight: 600; font-size: 1rem; color: var(--color-text); text-decoration: none;
    }
    .nav-logo:hover { text-decoration: none; }
    .nav-logo svg { width: 22px; height: 22px; }

    .nav-links { display: flex; align-items: center; gap: 0.25rem; }
    .nav-links a {
      color: var(--color-text-secondary); font-size: 0.875rem;
      padding: 0.5rem 0.75rem; border-radius: 6px;
      transition: all 0.15s ease; text-decoration: none;
    }
    .nav-links a:hover { color: var(--color-text); background: var(--color-surface); text-decoration: none; }
    .nav-links a.active { color: var(--color-text); background: var(--color-surface); }
    .nav-links .icon-link { display: flex; align-items: center; gap: 0.375rem; }
    .nav-links .icon-link svg { width: 18px; height: 18px; }

    /* Theme toggle */
    .theme-toggle {
      display: flex; align-items: center; justify-content: center;
      width: 36px; height: 36px;
      background: transparent; border: 1px solid var(--color-border);
      border-radius: 6px; cursor: pointer;
      color: var(--color-text-secondary);
      transition: all 0.15s ease;
    }
    .theme-toggle:hover { color: var(--color-text); border-color: var(--color-text-dim); background: var(--color-surface); }
    .theme-toggle svg { width: 18px; height: 18px; }
    .theme-toggle .sun { display: none; }
    .theme-toggle .moon { display: block; }
    [data-theme="light"] .theme-toggle .sun { display: block; }
    [data-theme="light"] .theme-toggle .moon { display: none; }

    /* Footer */
    footer {
      padding: 2.5rem 1.5rem;
      border-top: 1px solid var(--color-border);
    }
    .footer-inner {
      max-width: 1180px; margin: 0 auto;
      display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;
    }
    .footer-links { display: flex; align-items: center; gap: 1.5rem; }
    .footer-links a { font-size: 0.875rem; color: var(--color-text-secondary); transition: color 0.15s ease; }
    .footer-links a:hover { color: var(--color-text); text-decoration: none; }
    .footer-copy {
      font-family: var(--font-mono); font-size: 0.75rem;
      color: var(--color-text-muted); letter-spacing: 0.02em;
    }
    .footer-copy a { color: var(--color-text-secondary); }
    .footer-copy a:hover { color: var(--color-text); }

    /* Responsive */
    @media (max-width: 768px) {
      .nav-links a.hide-mobile { display: none; }
      .footer-inner { flex-direction: column; text-align: center; }
      .footer-links { flex-wrap: wrap; justify-content: center; gap: 1rem; }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
<body>

  <nav>
    <div class="nav-inner">
      <a href="/" class="nav-logo">
        <svg viewBox="0 0 64 89" fill="none">
          <rect x="43" y="70" width="8" height="21" transform="rotate(-90 43 70)" fill="#2563EB"/>
          <rect x="22" y="54" width="8" height="42" transform="rotate(-90 22 54)" fill="#2563EB"/>
          <rect x="28" y="38" width="8" height="36" transform="rotate(-90 28 38)" fill="#2563EB"/>
          <rect x="9" y="22" width="8" height="55" transform="rotate(-90 9 22)" fill="#2563EB"/>
        </svg>
        Logchef
      </a>

      <div class="nav-links">
        <a href="/getting-started/quickstart" class:list={[{ active: activeNav === 'docs' }, 'hide-mobile']}>Docs</a>
        <a href="/blog" class:list={[{ active: activeNav === 'blog' }, 'hide-mobile']}>Blog</a>
        <a href="/changelog" class:list={[{ active: activeNav === 'changelog' }, 'hide-mobile']}>Changelog</a>
        <a href="https://demo.logchef.app" target="_blank" class="hide-mobile">Demo</a>
        <a href="https://github.com/mr-karan/logchef" target="_blank" class="icon-link">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          <span class="hide-mobile">GitHub</span>
        </a>
        <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="5"/>
            <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
          </svg>
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <slot />

  <footer>
    <div class="footer-inner">
      <div class="footer-links">
        <a href="/">Home</a>
        <a href="/getting-started/quickstart">Docs</a>
        <a href="/changelog">Changelog</a>
        <a href="https://demo.logchef.app">Demo</a>
        <a href="https://github.com/mr-karan/logchef">GitHub</a>
      </div>
      <span class="footer-copy">Logchef · AGPLv3 · <a href="https://mrkaran.dev" target="_blank">@mr-karan</a></span>
    </div>
  </footer>

  <script>
    const toggle = document.getElementById('theme-toggle');
    toggle?.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('logchef-theme', next);
    });
  </script>
</body>
</html>
